/* Wey Editor Theme palette: Cyan.
   Synced to light.uss when selected in Preferences > Wey > Editor Theme. */

.unity-theme-env-variables,
:root {
    --unity-colors-alternated_rows-background: #D7EBEE;
    --unity-colors-app_toolbar-background: #B9D8DC;
    --unity-colors-app_toolbar_button-background: #D4EBEE;
    --unity-colors-app_toolbar_button-background-checked: #8EC8CE;
    --unity-colors-app_toolbar_button-background-hover: #C5E4E8;
    --unity-colors-app_toolbar_button-background-pressed: #8EC8CE;
    --unity-colors-app_toolbar_button-border: #7AAEB4;
    --unity-colors-app_toolbar_button-border_accent: #7AAEB4;

    --unity-colors-box-background: rgba(185, 216, 220, 0.55);
    --unity-colors-box-border: transparent;

    --unity-colors-button-background: #E7F4F6;
    --unity-colors-button-background-focus: #C5E4E8;
    --unity-colors-button-background-hover: #D4EBEE;
    --unity-colors-button-background-hover_pressed: #B3E0E4;
    --unity-colors-button-background-pressed: #9FD4DA;
    --unity-colors-button-border: #A8CDD2;
    --unity-colors-button-border_accent: #8BB8BE;
    --unity-colors-button-border_accent-focus: #1A8A94;
    --unity-colors-button-border-pressed: #5F9CA4;
    --unity-colors-button-text: #163236;

    --unity-colors-default-background: #C5DCE0;
    --unity-colors-default-border: #9CBEC4;
    --unity-colors-default-text: #163236;
    --unity-colors-default-text-hover: #163236;

    --unity-colors-dropdown-background: #E7F4F6;
    --unity-colors-dropdown-background-hover: #D4EBEE;
    --unity-colors-dropdown-border: #A8CDD2;
    --unity-colors-dropdown-border_accent: #8BB8BE;
    --unity-colors-dropdown-text: #163236;

    --unity-colors-headerbar-background: #D2EAED;
    --unity-colors-headerbar_column-background: #D2EAED;
    --unity-colors-headerbar_column-background-hover: #C5E4E8;
    --unity-colors-headerbar_column-background-pressed: #F3FAFB;

    --unity-colors-helpbox-background: rgba(232, 246, 248, 0.55);
    --unity-colors-helpbox-border: #A8CDD2;
    --unity-colors-helpbox-text: #163236;

    --unity-colors-highlight-background: #2A9AA6;
    --unity-colors-highlight-background-hover: rgba(26, 138, 148, 0.10);
    --unity-colors-highlight-background-hover-lighter: #B5D8DC;
    --unity-colors-highlight-background-inactive: #A8CDD2;
    --unity-colors-highlight-text: #0A4A50;
    --unity-colors-highlight-text-inactive: #163236;

    --unity-colors-input_field-background: #F7FCFD;
    --unity-colors-input_field-border: #B4D0D4;
    --unity-colors-input_field-border_accent: #9CBEC4;
    --unity-colors-input_field-border-focus: #1A8A94;
    --unity-colors-input_field-border-hover: #5F9CA4;

    --unity-colors-inspector_titlebar-background: #D2EAED;
    --unity-colors-inspector_titlebar-background-hover: #C5E4E8;
    --unity-colors-inspector_titlebar-border: #7AAEB4;
    --unity-colors-inspector_titlebar-border_accent: #B4D0D4;

    --unity-colors-label-text: #163236;
    --unity-colors-label-text-focus: #0A5C64;
    --unity-colors-link-text: #1A8A94;

    --unity-colors-list_view_item-background-hover: #D7EBEE;

    --unity-colors-object_field-background: #F3FAFB;
    --unity-colors-object_field-border: #B4D0D4;
    --unity-colors-object_field-border-focus: #1A8A94;
    --unity-colors-object_field-border-hover: #5F9CA4;
    --unity-colors-object_field_button-background: #E7F4F6;
    --unity-colors-object_field_button-background-hover: #D4EBEE;

    --unity-colors-play_mode-background: #DCEEEF;
    --unity-colors-popup-background: #E4F0F2;
    --unity-colors-preview-background: #E4F0F2;
    --unity-colors-preview-border: #9CBEC4;
    --unity-colors-preview-text: #163236;

    --unity-colors-progress-background: #8BB8BE;
    --unity-colors-scrollbar_button-background-hover: #C5DCE0;
    --unity-colors-scrollbar_thumb-background: #9CBEC4;
    --unity-colors-scrollbar_thumb-background-hover: #7AAEB4;
    --unity-colors-scrollbar_thumb-border: #B4D0D4;
    --unity-colors-scrollbar_thumb-border-hover: #7AAEB4;

    --unity-colors-slider_groove-background: #9CBEC4;
    --unity-colors-slider_groove-background-disabled: #C5DCE0;
    --unity-colors-slider_thumb-background: #1A8A94;
    --unity-colors-slider_thumb-background-hover: #157780;
    --unity-colors-slider_thumb-border: #1A8A94;
    --unity-colors-slider_thumb_halo-background: rgba(26, 138, 148, 0.45);

    --unity-colors-tab-background: #C8DDE0;
    --unity-colors-tab-background-checked: #F3FAFB;
    --unity-colors-tab-background-hover: #D7EBEE;
    --unity-colors-tab-text: #163236;

    --unity-colors-toolbar-background: #D2EAED;
    --unity-colors-toolbar-border: #9CBEC4;
    --unity-colors-toolbar_button-background: #D2EAED;
    --unity-colors-toolbar_button-background-checked: #F3FAFB;
    --unity-colors-toolbar_button-background-focus: #C5E4E8;
    --unity-colors-toolbar_button-background-hover: #C5E4E8;
    --unity-colors-toolbar_button-border: #9CBEC4;
    --unity-colors-toolbar_button-text: #163236;
    --unity-colors-toolbar_button-text-checked: #163236;
    --unity-colors-toolbar_button-text-hover: #163236;

    --unity-colors-tooltip-background: #E7F4F6;
    --unity-colors-tooltip-border: #7AAEB4;
    --unity-colors-visited_link-text: #0A5C64;

    --unity-colors-window-background: #E4F0F2;
    --unity-colors-window-border: #8BB8BE;
    --unity-colors-window-text: #163236;
    --wey-colors-selection-overlay: rgba(26, 138, 148, 0.08);
    --wey-colors-toolbar-hover-mid: #A8D8DE;
    --wey-colors-toolbar-active-mid: #6EC4CC;
}
