/* Wey Editor Theme palette: Sand.
   Synced to light.uss when selected in Preferences > Wey > Editor Theme. */

.unity-theme-env-variables,
:root {
    --unity-colors-alternated_rows-background: #EBE7D7;
    --unity-colors-app_toolbar-background: #D8D0B9;
    --unity-colors-app_toolbar_button-background: #EBE4D4;
    --unity-colors-app_toolbar_button-background-checked: #C8B88E;
    --unity-colors-app_toolbar_button-background-hover: #E4DCC5;
    --unity-colors-app_toolbar_button-background-pressed: #C8B88E;
    --unity-colors-app_toolbar_button-border: #AEA47A;
    --unity-colors-app_toolbar_button-border_accent: #AEA47A;

    --unity-colors-box-background: rgba(216, 208, 185, 0.55);
    --unity-colors-box-border: transparent;

    --unity-colors-button-background: #F4F2E7;
    --unity-colors-button-background-focus: #E4DCC5;
    --unity-colors-button-background-hover: #EBE4D4;
    --unity-colors-button-background-hover_pressed: #E0D8B3;
    --unity-colors-button-background-pressed: #D4C89F;
    --unity-colors-button-border: #CDC0A8;
    --unity-colors-button-border_accent: #B8B08B;
    --unity-colors-button-border_accent-focus: #A89070;
    --unity-colors-button-border-pressed: #9C905F;
    --unity-colors-button-text: #363024;

    --unity-colors-default-background: #DCD4C5;
    --unity-colors-default-border: #BEB49C;
    --unity-colors-default-text: #363024;
    --unity-colors-default-text-hover: #363024;

    --unity-colors-dropdown-background: #F4F2E7;
    --unity-colors-dropdown-background-hover: #EBE4D4;
    --unity-colors-dropdown-border: #CDC0A8;
    --unity-colors-dropdown-border_accent: #B8B08B;
    --unity-colors-dropdown-text: #363024;

    --unity-colors-headerbar-background: #EAE4D2;
    --unity-colors-headerbar_column-background: #EAE4D2;
    --unity-colors-headerbar_column-background-hover: #E4DCC5;
    --unity-colors-headerbar_column-background-pressed: #F2EDE4;

    --unity-colors-helpbox-background: rgba(246, 242, 232, 0.55);
    --unity-colors-helpbox-border: #CDC0A8;
    --unity-colors-helpbox-text: #363024;

    --unity-colors-highlight-background: #A89070;
    --unity-colors-highlight-background-hover: rgba(168, 144, 112, 0.10);
    --unity-colors-highlight-background-hover-lighter: #D8CCB5;
    --unity-colors-highlight-background-inactive: #CDC0A8;
    --unity-colors-highlight-text: #504A0A;
    --unity-colors-highlight-text-inactive: #363024;

    --unity-colors-input_field-background: #FDFBF7;
    --unity-colors-input_field-border: #D0C8B4;
    --unity-colors-input_field-border_accent: #BEB49C;
    --unity-colors-input_field-border-focus: #A89070;
    --unity-colors-input_field-border-hover: #9C905F;

    --unity-colors-inspector_titlebar-background: #EAE4D2;
    --unity-colors-inspector_titlebar-background-hover: #E4DCC5;
    --unity-colors-inspector_titlebar-border: #AEA47A;
    --unity-colors-inspector_titlebar-border_accent: #D0C8B4;

    --unity-colors-label-text: #363024;
    --unity-colors-label-text-focus: #5C500A;
    --unity-colors-link-text: #A89070;

    --unity-colors-list_view_item-background-hover: #EBE7D7;

    --unity-colors-object_field-background: #F2EDE4;
    --unity-colors-object_field-border: #D0C8B4;
    --unity-colors-object_field-border-focus: #A89070;
    --unity-colors-object_field-border-hover: #9C905F;
    --unity-colors-object_field_button-background: #F4F2E7;
    --unity-colors-object_field_button-background-hover: #EBE4D4;

    --unity-colors-play_mode-background: #EEE8DC;
    --unity-colors-popup-background: #F0EAE4;
    --unity-colors-preview-background: #F0EAE4;
    --unity-colors-preview-border: #BEB49C;
    --unity-colors-preview-text: #363024;

    --unity-colors-progress-background: #B8B08B;
    --unity-colors-scrollbar_button-background-hover: #DCD4C5;
    --unity-colors-scrollbar_thumb-background: #BEB49C;
    --unity-colors-scrollbar_thumb-background-hover: #AEA47A;
    --unity-colors-scrollbar_thumb-border: #D0C8B4;
    --unity-colors-scrollbar_thumb-border-hover: #AEA47A;

    --unity-colors-slider_groove-background: #BEB49C;
    --unity-colors-slider_groove-background-disabled: #DCD4C5;
    --unity-colors-slider_thumb-background: #A89070;
    --unity-colors-slider_thumb-background-hover: #807050;
    --unity-colors-slider_thumb-border: #A89070;
    --unity-colors-slider_thumb_halo-background: rgba(168, 144, 112, 0.45);

    --unity-colors-tab-background: #DCD4C8;
    --unity-colors-tab-background-checked: #F2EDE4;
    --unity-colors-tab-background-hover: #EBE7D7;
    --unity-colors-tab-text: #363024;

    --unity-colors-toolbar-background: #EAE4D2;
    --unity-colors-toolbar-border: #BEB49C;
    --unity-colors-toolbar_button-background: #EAE4D2;
    --unity-colors-toolbar_button-background-checked: #F2EDE4;
    --unity-colors-toolbar_button-background-focus: #E4DCC5;
    --unity-colors-toolbar_button-background-hover: #E4DCC5;
    --unity-colors-toolbar_button-border: #BEB49C;
    --unity-colors-toolbar_button-text: #363024;
    --unity-colors-toolbar_button-text-checked: #363024;
    --unity-colors-toolbar_button-text-hover: #363024;

    --unity-colors-tooltip-background: #F4F2E7;
    --unity-colors-tooltip-border: #AEA47A;
    --unity-colors-visited_link-text: #5C500A;

    --unity-colors-window-background: #F0EAE4;
    --unity-colors-window-border: #B8B08B;
    --unity-colors-window-text: #363024;
    --wey-colors-selection-overlay: rgba(168, 144, 112, 0.08);
    --wey-colors-toolbar-hover-mid: #D8C8A8;
    --wey-colors-toolbar-active-mid: #C4B06E;
}
