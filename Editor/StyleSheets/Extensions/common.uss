.dragtab-first,
.dragtab {
    background-image: none;
    background-color: var(--unity-colors-tab-background);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: var(--unity-colors-default-background);
    border-bottom-color: var(--unity-colors-default-background);
    border-left-color: var(--unity-colors-default-background);
    border-right-color: var(--unity-colors-default-background);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
}

.dragtab-first:hover,
.dragtab-first:checked,
.dragtab:hover,
.dragtab:checked {
    background-color: var(--unity-colors-object_field-background);
}

.AppCommandLeftOn {
    background-image: none;
    background-color: var(--unity-colors-app_toolbar_button-background-checked);
    border-top-color: var(--unity-colors-app_toolbar_button-border);
    border-bottom-color: var(--unity-colors-app_toolbar_button-border);
    border-left-color: var(--unity-colors-app_toolbar_button-border);
