/* Wey Editor Theme: shared selector rules. Colors from active palette in light.uss. */

.AppToolbar,
.ScrollViewAlt,
.Toolbar,
.dockarea,
.dockArea,
.ProjectBrowserBottomBarBg,
.ProjectBrowserTopBarBg,
.ProjectBrowserIconAreaBg,
.TabWindowBackground,
.PreToolbar,
.IN-Footer,
.IN-BigTitle,
.SceneTopBarBg,
.PreBackground,
.RL-Header,
.RL-Background,
.RL-Footer,
.hostview,
.ScriptText {
    background-image: none;
    background-color: var(--unity-colors-object_field-background);
    border-top-color: var(--unity-colors-default-background);
    border-bottom-color: var(--unity-colors-default-background);
    border-left-color: var(--unity-colors-default-background);
    border-right-color: var(--unity-colors-default-background);
}

.AppToolbar {
    background-color: var(--unity-colors-app_toolbar-background);
}

.dockHeader,
.FoldoutHeader {
    background-color: var(--unity-colors-toolbar-background);
    border-top-color: var(--unity-colors-default-background);
    border-bottom-color: var(--unity-colors-default-background);
    border-left-color: var(--unity-colors-default-background);
    border-right-color: var(--unity-colors-default-background);
}

.WhiteBackground,
.TV-Selection {
    background-image: none;
    background-color: var(--wey-colors-selection-overlay);
}

