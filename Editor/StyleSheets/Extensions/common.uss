#Play.unity-editor-toolbar-toggle,
#Pause.unity-editor-toolbar-toggle,
#Step.unity-toolbar-button,
.unity-editor-toolbar-container #Play,
.unity-editor-toolbar-container #Pause,
.unity-editor-toolbar-container #Step {
    background-image: none;
    background-color: var(--unity-colors-button-background-focus);
    border-top-color: var(--unity-colors-app_toolbar_button-border);
    border-bottom-color: var(--unity-colors-app_toolbar_button-border);
    border-left-color: var(--unity-colors-app_toolbar_button-border);
    border-right-color: var(--unity-colors-app_toolbar_button-border);
}

#Play.unity-editor-toolbar-toggle:hover,
#Pause.unity-editor-toolbar-toggle:hover,
#Step.unity-toolbar-button:hover,
.unity-editor-toolbar-container #Play:hover,
.unity-editor-toolbar-container #Pause:hover,
.unity-editor-toolbar-container #Step:hover {
    background-image: none;
    background-color: var(--wey-colors-toolbar-hover-mid);
    border-top-color: var(--unity-colors-button-border-pressed);
    border-bottom-color: var(--unity-colors-button-border-pressed);
    border-left-color: var(--unity-colors-button-border-pressed);
    border-right-color: var(--unity-colors-button-border-pressed);
}

#Play.unity-editor-toolbar-toggle:checked,
#Pause.unity-editor-toolbar-toggle:checked,
#Play.unity-editor-toolbar-toggle:active,
#Pause.unity-editor-toolbar-toggle:active,
#Step.unity-toolbar-button:active,
.unity-editor-toolbar-container #Play:checked,
.unity-editor-toolbar-container #Pause:checked,
.unity-editor-toolbar-container #Play:active,
.unity-editor-toolbar-container #Pause:active,
.unity-editor-toolbar-container #Step:active {
    background-image: none;
    background-color: var(--wey-colors-toolbar-active-mid);
    border-top-color: var(--unity-colors-input_field-border-focus);
    border-bottom-color: var(--unity-colors-input_field-border-focus);
    border-left-color: var(--unity-colors-input_field-border-focus);
    border-right-color: var(--unity-colors-input_field-border-focus);
}

